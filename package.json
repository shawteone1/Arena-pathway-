{
  "name": "arena-pathway",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "node --check server.mjs && node --check src/views.mjs && node --check public/app.js && node --check public/siem.js && node --check public/siem-model.js && node --check src/siem-view.mjs && node --check src/release-views.mjs && node --check public/release-demo.js && node --check public/release-demo-model.js && node --check public/siem-platform.js && node --check public/siem-platform-model.js && node --check public/siem-platform-fixtures.js && node --check src/siem-platform-view.mjs && node --check public/siem-family-fixtures.js && node --check public/siem-platform-boot.js && node --check src/siem-navigation.mjs && npm run validate:data && npm run validate:participation && npm run discovery:check && npm test",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "data:import": "node scripts/data-engine.mjs import",
    "data:approve": "node scripts/data-engine.mjs approve",
    "data:validate": "node scripts/data-engine.mjs validate",
    "data:export": "node scripts/data-engine.mjs export",
    "data:report": "node scripts/data-engine.mjs report",
    "data:refresh": "node scripts/data-engine.mjs refresh",
    "data:backup": "node scripts/data-engine.mjs backup",
    "data:bootstrap": "node scripts/data-engine.mjs bootstrap",
    "data:interrupt": "node scripts/data-engine.mjs interrupt",
    "test:workspace:browser": "python scripts/qa-pathway.py",
    "data:classify": "node scripts/reconcile-participation.mjs",
    "validate:participation": "node scripts/validate-participation.mjs",
    "test:release:browser": "python scripts/qa-release.py",
    "test:siem:browser": "python scripts/qa-siem-platform.py",
    "test:siem:refinement:browser": "python scripts/qa-siem-refinement.py",
    "test:siem:family:browser": "python scripts/qa-siem-family.py",
    "test:siem:webkit": "python scripts/qa-siem-webkit.py",
    "test:my-ap:browser": "python scripts/qa-my-ap.py",
    "discovery:check": "node scripts/sports-discovery.mjs check",
    "discovery:build": "node scripts/sports-discovery.mjs build",
    "discovery:replay": "node scripts/sports-discovery.mjs replay",
    "discovery:prove": "node scripts/prove-discovery-replay.mjs",
    "discovery:refresh-plan": "node scripts/sports-discovery.mjs refresh-plan",
    "acquisition:run": "node scripts/acquire-v2.mjs run",
