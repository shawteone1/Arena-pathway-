    "acquisition:export": "node scripts/acquire-v2.mjs export",
    "acquisition:bootstrap": "node scripts/acquire-v2.mjs bootstrap",
    "acquisition:evaluate": "node scripts/evaluate-acquisition-v2.mjs",
    "acquisition:acceptance": "node scripts/evaluate-acquisition-v2.mjs --assert-acceptance",
    "acquisition:controlled": "node scripts/acquisition-controlled.mjs",
    "acquisition:console": "node scripts/acquisition-console.mjs",
    "test:acquisition:browser": "python scripts/qa-acquisition.py"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "robots-parser": "3.0.1",
    "undici": "7.30.2"
